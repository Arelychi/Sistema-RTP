APP_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-segura
# Render proporciona esta variable al enlazar una base PostgreSQL.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/base_de_datos

# Alternativa local si no usas DATABASE_URL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ProgramacionDeControladores
PGUSER=postgres
PGPASSWORD=tu_contraseña
